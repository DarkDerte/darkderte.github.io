---
const enlaces = [
  { href: '/', label: 'Inicio' },
  { href: '/codigo/', label: 'CodigoMinimo' },
  { href: '/hardware/', label: 'HardwareSimple' },
  { href: '/nanointernet/', label: 'NanoInternet' },
  { href: '/sobre-mi/', label: 'Sobre mí' },
];
const actual = Astro.url.pathname;
---

<header class="cabecera">
  <nav class="nav contenedor" aria-label="Navegación principal">
    <a class="logo" href="/">
      <span class="logo-mark">_</span>
      tecnologia<span class="logo-muted"> útil</span>
    </a>
    <ul class="nav-links">
      {
        enlaces.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class={actual === href || (href !== '/' && actual.startsWith(`${href}/`)) ? 'activo' : ''}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .cabecera {
    border-bottom: 1px solid var(--borde);
    background: var(--fondo);
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(8px);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.5rem;
  }
  .logo {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.02em;
    color: var(--texto);
    text-decoration: none;
  }
  .logo-mark {
    color: var(--acento);
    margin-right: 0.25rem;
  }
  .logo-muted {
    color: var(--texto-suave);
  }
  .nav-links {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-links a {
    color: var(--texto-suave);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.15s ease;
  }
  .nav-links a:focus-visible, .logo:focus-visible {
    outline: 2px solid var(--acento);
    outline-offset: 5px;
    border-radius: 2px;
  }
  .nav-links a:hover,
  .nav-links a.activo {
    color: var(--texto);
  }
  .nav-links a.activo {
    color: var(--acento);
  }
  @media (max-width: 680px) {
    .nav { height: auto; min-height: 3.5rem; align-items: flex-start; flex-direction: column; gap: 0.35rem; padding-top: 0.7rem; padding-bottom: 0.65rem; }
    .nav-links {
      width: 100%; gap: 0.35rem 1rem; flex-wrap: wrap;
    }
    .nav-links a { font-size: 0.82rem; }
  }
</style>
