---

const anio = new Date().getFullYear();
---

<footer class="pie">
  <div class="contenedor">
    <p class="pie-lema">
      <span class="prompt">$</span> menos código, más valor.
    </p>
    <p class="pie-meta">
      Hecho a mano con Astro · Sin rastreadores · Sin JavaScript innecesario · {anio}
    </p>
  </div>
</footer>

<style>
  .pie {
    border-top: 1px solid var(--borde);
    padding: 2rem 0 2.5rem;
    margin-top: 4rem;
  }
  .pie-lema {
    font-family: var(--mono);
    margin: 0 0 0.5rem;
    color: var(--texto);
  }
  .prompt {
    color: var(--acento);
    margin-right: 0.5rem;
  }
  .pie-meta {
    margin: 0;
    font-size: 0.8rem;
    color: var(--texto-apagado);
  }
</style>
