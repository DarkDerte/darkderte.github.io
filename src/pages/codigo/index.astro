---
import Layout from '../../layouts/Layout.astro';
import AppCard from '../../components/AppCard.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import { getCollection } from 'astro:content';

const apps = await getCollection('apps');
const destacadas = apps.filter((app) => app.data.destacado);
const resto = apps.filter((app) => !app.data.destacado);
const categories = [...new Set(apps.map((app) => app.data.category))].sort((a, b) => a.localeCompare(b, 'es'));
---

<Layout area="codigo" title="CodigoMinimo — Software práctico y ligero" description="Programación, herramientas y proyectos de software diseñados para resolver problemas con claridad y eficiencia.">
  <section class="hero contenedor">
    <p class="hero-terminal"><span class="prompt">$</span> ./código-minimo --explorar</p>
    <h1>Software útil, <span class="destacado">sin peso innecesario.</span></h1>
    <p class="sub">CodigoMinimo reúne ideas, utilidades y proyectos de desarrollo. Una forma de construir software sencillo de entender, rápido y mantenible.</p>
    <div class="cta"><a class="btn btn-primario" href="#apps">Ver apps</a><a class="btn btn-secundario" href="/filosofia">Leer la filosofía</a></div>
  </section>
  <section class="seccion contenedor" id="apps">
    <h2 class="seccion-titulo"><span class="num">01</span>Proyectos de software</h2>
    <p class="intro">El catálogo conserva las fichas actuales, con su estado, detalles y enlaces de cada proyecto.</p>
    <CategoryFilter name="codigo-categoria" label="Filtrar apps por categoría" categories={categories} contained>
    {destacadas.length > 0 && <><h3>Destacadas</h3><div class="grid-apps">{destacadas.map((app) => <AppCard app={app} />)}</div></>}
    <h3>Todas las aplicaciones</h3><div class="grid-apps">{resto.map((app) => <AppCard app={app} />)}</div>
    </CategoryFilter>
  </section>
</Layout>

<style>
  .intro { max-width:42rem; color:var(--texto-suave); }
  h3 { margin:2rem 0 0; font-size:1.1rem; }
  .grid-apps { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:1rem; margin-top:1rem; }
</style>
